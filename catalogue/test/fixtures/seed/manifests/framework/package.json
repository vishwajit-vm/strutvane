{
  "name": "@strutvane/framework",
  "version": "0.2.0",
  "description": "Kernel, HTTP, ORM, migrations, auth, tenancy, console",
  "license": "MIT",
  "type": "module",
  "strutvane": {
    "manifestVersion": 1,
    "id": "framework",
    "displayName": "Framework",
    "description": "Kernel, HTTP, ORM, migrations, auth, tenancy, console",
    "category": "core",
    "tags": [
      "kernel",
      "orm",
      "http"
    ],
    "kind": "package",
    "popular": false,
    "docs": "https://github.com/vishwajit-vm/strutvane-framework#readme",
    "framework": "^0.2",
    "installs": {
      "config": [
        "config/app.ts",
        "config/database.ts"
      ],
      "env": [
        {
          "key": "APP_KEY",
          "description": "Encryption key, generated by the installer",
          "secret": true
        },
        {
          "key": "APP_URL",
          "description": "The URL the app is served from",
          "secret": false,
          "example": "http://localhost:3000"
        }
      ],
      "routes": [
        {
          "method": "GET",
          "path": "/up"
        },
        {
          "method": "GET",
          "path": "/ready"
        },
        {
          "method": "GET",
          "path": "/openapi.json"
        }
      ],
      "commands": [
        {
          "name": "migrate",
          "description": "Run migrations, then seed"
        },
        {
          "name": "make:migration",
          "description": "Create a migration, model, factory and seeder"
        }
      ]
    }
  }
}
