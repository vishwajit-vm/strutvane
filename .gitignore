# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.vitest/

# Environment & secrets: never commit real env files
.env
.env.*
!.env.example
*.pem
*.key

# Docker: local development only, never committed (ADR-0006)
docker/
Dockerfile*
.dockerignore
compose.yaml
compose.*.yaml
docker-compose*.yml
docker-compose*.yaml

# Logs & OS / editor files
logs/
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: personal, machine-local settings
.claude/settings.local.json

# Package repos: each is its own Git repository (ADR-0002)
packages/

# Local-only umbrella workspace files (never committed)
/pnpm-workspace.yaml
/pnpm-lock.yaml
/package.json
node_modules/

# Local end-to-end integration harness (generated, never committed)
/integration-local/

# Local full-app test project (Docker files live here; never committed, ADR-0006)
/playground/
