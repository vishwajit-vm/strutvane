APP_NAME="Strutvane Blog"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_KEY=

# MySQL is the default (DB_CONNECTION=mysql). The example runs on SQLite with no server:
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
