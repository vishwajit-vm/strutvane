{
  "name": "spike-16-charts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Spike 16: can @strutvane/charts suggest useful charts from resources.json, render them themed and accessible in the React admin, and serve the numbers from one strict, tenant- and policy-scoped aggregate endpoint on every engine?",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#strutvane/charts": "./src/shared/define-charts.ts"
  },
  "scripts": {
    "charts:sync": "node scripts/charts-sync.ts example",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc --noEmit -p . && vitest run",
    "build": "tsc --noEmit -p . && vite build"
  },
  "dependencies": {
    "@fontsource/public-sans": "5.3.0",
    "@tabler/icons-react": "3.50.0",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "oxc-parser": "0.158.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
