            }
          },
          "422": {
            "description": "Invalid filter, sort or page parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "description": "Row filter: `filter[<field>][<operator>]=<value>`. Repeat the key for `in`, `nin` and `between`; `isNull`/`isNotNull` take `true`. Only listed fields and operators are accepted.",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "object",
                  "properties": {
                    "eq": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "contains": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "startsWith": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "additionalProperties": false
                },
                "email": {
                  "type": "object",
                  "properties": {
                    "eq": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    }
                  },
                  "additionalProperties": false
                },
                "region": {
                  "type": "object",
                  "properties": {
                    "eq": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 2
                    },
                    "in": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      }
                    },
                    "isNull": {
                      "type": "boolean",
                      "const": true
                    },
                    "isNotNull": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "id": {
                  "type": "object",
                  "properties": {
                    "eq": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "in": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "x-strutvane-serialization": "strutvane-list-query"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": false,
            "description": "Comma-separated sort fields; prefix with `-` for descending. An `id` tiebreak is always applied.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "-name",
                  "createdAt",
                  "-createdAt"
                ]
              }
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "description": "`page[size]` (1–100, default 25) and either `page[cursor]` (opaque) or `page[number]`.",
