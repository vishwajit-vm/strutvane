              "type": "object",
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "cursor": {
                  "type": "string"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          {
            "name": "search",
