{
  "name": "@strutvane/log-viewer",
  "version": "0.1.0",
  "description": "Browse and search app logs at /_strutvane/logs",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@strutvane/framework": "^0.2"
