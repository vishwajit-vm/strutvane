--- a/src/templates/env.ts
+++ b/src/templates/env.ts
@@ -108,8 +108,14 @@ export function envRefinements(keys: ReadonlySet<string>): readonly string[] {
   }
   if (keys.has('CORS_ORIGINS')) {
     checks.push(
+      // Zod 4 still runs object refinements when a field failed its own check, so an empty
+      // CORS_ORIGINS arrives here as the raw string ''. Calling .some() on it would throw, Zod's
+      // Standard Schema validate() then retries asynchronously, and defineEnv reports
+      // "asynchronous validators are not supported" instead of the real problem.
+      '    // A field that failed its own check reaches this point unparsed: only check real lists.',
+      '    const origins: readonly string[] = Array.isArray(env.CORS_ORIGINS) ? env.CORS_ORIGINS : []',
       '    // config/cors.ts allows credentials (cookies), so a wildcard origin is never safe.',
-      "    if (env.CORS_ORIGINS.some((origin) => origin.includes('*'))) {",
+      "    if (origins.some((origin) => origin.includes('*'))) {",
       '      ctx.addIssue({',
       "        code: 'custom',",
       "        path: ['CORS_ORIGINS'],",
@@ -119,7 +125,7 @@ export function envRefinements(keys: ReadonlySet<string>): readonly string[] {
     )
     if (keys.has('APP_ENV')) {
       checks.push(
-        "    const insecure = env.CORS_ORIGINS.some((origin) => !origin.startsWith('https://'))",
+        "    const insecure = origins.some((origin) => !origin.startsWith('https://'))",
         "    if (env.APP_ENV === 'production' && insecure) {",
         '      ctx.addIssue({',
         "        code: 'custom',",
