diff --git a/test/security-defaults.test.ts b/test/security-defaults.test.ts
index ce42858..feab928 100644
--- a/test/security-defaults.test.ts
+++ b/test/security-defaults.test.ts
@@ -241,7 +241,10 @@ describe('reverse proxies are not trusted by default', () => {
 })
 
 describe('env.schema.ts refusals (executed with the real Zod)', () => {
-  type Schema = { safeParse(v: unknown): { success: boolean } }
+  type Schema = {
+    safeParse(v: unknown): { success: boolean }
+    '~standard': { validate(v: unknown): unknown }
+  }
   let schema: Schema
   let dir: string
   const valid: Record<string, string> = {}
@@ -314,6 +317,25 @@ describe('env.schema.ts refusals (executed with the real Zod)', () => {
     ).toBe(true)
   })
 
+  // Regression: an empty CORS_ORIGINS crashed the refinement (.some on a string), and the app
+  // refused to boot with "asynchronous validators are not supported for env" instead of naming
+  // the key. defineEnv uses the Standard Schema validate(), which must stay synchronous.
+  test.each(['', undefined])(
+    'CORS_ORIGINS=%s is a normal, synchronous issue (never a crash)',
+    (value) => {
+      const input: Record<string, string | undefined> = { ...valid, CORS_ORIGINS: value }
+      if (value === undefined) delete input['CORS_ORIGINS']
+      for (const env of ['local', 'production']) {
+        const source = { ...input, APP_ENV: env, APP_DEBUG: 'false' }
+        expect(() => schema.safeParse(source)).not.toThrow()
+        expect(schema.safeParse(source).success).toBe(false)
+        const result = schema['~standard'].validate(source)
+        expect(result).not.toBeInstanceOf(Promise)
+        expect(JSON.stringify(result)).toContain('CORS_ORIGINS')
+      }
+    },
+  )
+
   test('each check is emitted only when its keys exist', () => {
     expect(envRefinements(new Set())).toEqual([])
     expect(envRefinements(new Set(['APP_DEBUG'])).join('\n')).toBe('')
